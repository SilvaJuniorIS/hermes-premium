# Copie para ".env" na raiz do projeto e preencha os valores.
# O ficheiro ".env" esta no .gitignore — nunca commite segredos.

# --- Sessao web (api.py) ---
# Em producao com HTTPS, defina true para o cookie de sessao so ir por canal seguro.
HERMES_COOKIE_SECURE=false

# Apenas ambiente local: mostra no ecra a dica admin / admin123 (desligue em producao).
HERMES_DEV_LOGIN_HINT=true

# --- E-mail (src/notifier.py) ---
HERMES_SMTP_HOST=smtp.gmail.com
HERMES_SMTP_PORT=465
HERMES_SMTP_USER=
HERMES_SMTP_PASSWORD=
HERMES_EMAIL_FROM=

# Destino opcional para alertas automaticos (enviar_email_alerta).
HERMES_ALERT_EMAIL_TO=

# Numero E.164 para alertas WhatsApp (ex: +5511999999999). Deixe vazio para desativar.
HERMES_WHATSAPP_E164=

# --- IA (opcional) ---
OPENAI_API_KEY=
